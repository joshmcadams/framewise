{
  "compilerOptions": {
    // target matches lib (ES2022): lib governs which runtime APIs typecheck,
    // target governs syntax downleveling — letting lib lead would admit
    // Object.hasOwn/.at()/findLast with no polyfill on an older runtime.
    // Safe here: the package declares node >= 20, where both exist.
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vitest/globals"]
  },
  "include": ["src", "vite.config.ts"]
}
